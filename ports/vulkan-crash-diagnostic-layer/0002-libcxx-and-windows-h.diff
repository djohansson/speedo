diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index bfe6b44..d6aa226 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -103,6 +103,11 @@ if(ANDROID)
 target_link_libraries(crash_diagnostic PUBLIC log)
 endif()
 
+if(WIN32)
+    # windows.h's rpcndr.h defines small as char, which breaks Vulkan-Utility-Libraries' vku::small
+    target_compile_definitions(crash_diagnostic PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
+endif()
+
 if(MSVC)
     target_link_options(crash_diagnostic PRIVATE /DEF:${CMAKE_CURRENT_SOURCE_DIR}/${LAYER_NAME}.def)
     target_compile_options(crash_diagnostic PRIVATE /bigobj)
