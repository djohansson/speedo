From 8f9d8e96ff3bef8d4a145573172b315e5e04b8f9 Mon Sep 17 00:00:00 2001
From: Daniel Johansson <1911831+djohansson@users.noreply.github.com>
Date: Thu, 1 Oct 2026 20:40:47 +0200
Subject: [PATCH] profiler: fix embed step dependencies for FASTBuild

A directory as custom command OUTPUT breaks the FASTBuild generator, which expects outputs to be files, so create it at configure time. Also depend on the embed executable itself (an install byproduct of the external project) rather than on the target name, which FASTBuild does not order custom commands after.
---
 profiler/CMakeLists.txt | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/profiler/CMakeLists.txt b/profiler/CMakeLists.txt
index 049032a..4ab7d87 100644
--- a/profiler/CMakeLists.txt
+++ b/profiler/CMakeLists.txt
@@ -38,18 +38,18 @@ ExternalProject_Add(embed
     CMAKE_ARGS
         -DCMAKE_BUILD_TYPE=Release
         -DCMAKE_INSTALL_PREFIX=${CMAKE_CURRENT_BINARY_DIR}
+    INSTALL_BYPRODUCTS ${CMAKE_CURRENT_BINARY_DIR}/embed${CMAKE_EXECUTABLE_SUFFIX}
 )
 
-add_custom_command(
-    OUTPUT data
-    COMMAND ${CMAKE_COMMAND} -E make_directory data
-)
+# create the output directory at configure time: a directory as a custom command OUTPUT is not supported by
+# generators that require outputs to be files (FASTBuild: "File missing despite success")
+file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/data)
 
 function(Embed LIST NAME FILE)
     add_custom_command(
         OUTPUT data/${NAME}.cpp data/${NAME}.hpp
         COMMAND ${CMAKE_CURRENT_BINARY_DIR}/embed ${NAME} ${CMAKE_CURRENT_LIST_DIR}/${FILE} data/${NAME}
-        DEPENDS data embed ${CMAKE_CURRENT_LIST_DIR}/${FILE}
+        DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/embed${CMAKE_EXECUTABLE_SUFFIX} ${CMAKE_CURRENT_LIST_DIR}/${FILE}
     )
     list(APPEND ${LIST} data/${NAME}.cpp)
     return(PROPAGATE ${LIST})
