From 945a866341091e27bf5301d1b9349e1dcf307e27 Mon Sep 17 00:00:00 2001
From: Daniel Johansson <1911831+djohansson@users.noreply.github.com>
Date: Tue, 6 Oct 2026 14:29:00 +0200
Subject: [PATCH] profiler: build embed in-project when targeting the host

The ExternalProject configure for embed inherits the generator but not the compiler/toolchain, and fails when no compiler is on PATH (vcpkg clang triplets on Windows). Build it as a regular target when the target system and processor are the host's, keeping the ExternalProject otherwise, where it has to target the host. CMAKE_CROSSCOMPILING can't be used for this: it is true whenever a toolchain sets CMAKE_SYSTEM_NAME.
---
 profiler/CMakeLists.txt | 36 ++++++++++++++++++++++++++----------
 1 file changed, 26 insertions(+), 10 deletions(-)

diff --git a/profiler/CMakeLists.txt b/profiler/CMakeLists.txt
index fcf0e7a..a3cb11d 100644
--- a/profiler/CMakeLists.txt
+++ b/profiler/CMakeLists.txt
@@ -32,14 +32,30 @@ include(${CMAKE_CURRENT_LIST_DIR}/../cmake/config.cmake)
 include(${CMAKE_CURRENT_LIST_DIR}/../cmake/vendor.cmake)
 include(${CMAKE_CURRENT_LIST_DIR}/../cmake/server.cmake)
 
-include(ExternalProject)
-ExternalProject_Add(embed
-    SOURCE_DIR ${CMAKE_CURRENT_LIST_DIR}/helpers
-    CMAKE_ARGS
-        -DCMAKE_BUILD_TYPE=Release
-        -DCMAKE_INSTALL_PREFIX=${CMAKE_CURRENT_BINARY_DIR}
-    INSTALL_BYPRODUCTS ${CMAKE_CURRENT_BINARY_DIR}/embed${CMAKE_EXECUTABLE_SUFFIX}
-)
+# embed is a host tool run at build time. when the target is the host, build it in this project with the same toolchain:
+# the separate configure of an ExternalProject inherits the generator but not the compiler/toolchain settings, and fails
+# when no compiler is on PATH (e.g. vcpkg's clang triplets on windows: "No CMAKE_CXX_COMPILER could be found").
+# compares system and processor rather than CMAKE_CROSSCOMPILING, which is true whenever a toolchain file sets
+# CMAKE_SYSTEM_NAME, even to the host system.
+if(NOT (CMAKE_SYSTEM_NAME STREQUAL CMAKE_HOST_SYSTEM_NAME AND CMAKE_SYSTEM_PROCESSOR STREQUAL CMAKE_HOST_SYSTEM_PROCESSOR))
+    include(ExternalProject)
+    ExternalProject_Add(embed
+        SOURCE_DIR ${CMAKE_CURRENT_LIST_DIR}/helpers
+        CMAKE_ARGS
+            -DCMAKE_BUILD_TYPE=Release
+            -DCMAKE_INSTALL_PREFIX=${CMAKE_CURRENT_BINARY_DIR}
+        INSTALL_BYPRODUCTS ${CMAKE_CURRENT_BINARY_DIR}/embed${CMAKE_EXECUTABLE_SUFFIX}
+    )
+    set(EMBED_EXECUTABLE ${CMAKE_CURRENT_BINARY_DIR}/embed${CMAKE_EXECUTABLE_SUFFIX})
+else()
+    add_executable(embed
+        ${CMAKE_CURRENT_LIST_DIR}/../public/common/tracy_lz4.cpp
+        ${CMAKE_CURRENT_LIST_DIR}/../public/common/tracy_lz4hc.cpp
+        ${CMAKE_CURRENT_LIST_DIR}/helpers/embed.cpp
+    )
+    # an executable target in COMMAND/DEPENDS adds both the target and the file dependency on its output
+    set(EMBED_EXECUTABLE embed)
+endif()
 
 # create the output directory at configure time: a directory as a custom command OUTPUT is not supported by
 # generators that require outputs to be files (FASTBuild: "File missing despite success")
@@ -48,8 +64,8 @@ file(MAKE_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}/data)
 function(Embed LIST NAME FILE)
     add_custom_command(
         OUTPUT data/${NAME}.cpp data/${NAME}.hpp
-        COMMAND ${CMAKE_CURRENT_BINARY_DIR}/embed ${NAME} ${CMAKE_CURRENT_LIST_DIR}/${FILE} data/${NAME}
-        DEPENDS ${CMAKE_CURRENT_BINARY_DIR}/embed${CMAKE_EXECUTABLE_SUFFIX} ${CMAKE_CURRENT_LIST_DIR}/${FILE}
+        COMMAND ${EMBED_EXECUTABLE} ${NAME} ${CMAKE_CURRENT_LIST_DIR}/${FILE} data/${NAME}
+        DEPENDS ${EMBED_EXECUTABLE} ${CMAKE_CURRENT_LIST_DIR}/${FILE}
     )
     list(APPEND ${LIST} data/${NAME}.cpp)
     return(PROPAGATE ${LIST})
-- 
