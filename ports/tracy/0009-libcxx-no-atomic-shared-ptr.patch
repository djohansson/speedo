+// libc++ has no std::atomic<std::shared_ptr> (P0718): the same load and store under a lock. A replaced view is
+// released after the lock, as the store's argument
+class AtomicViewPtr
+{
+public:
+    std::shared_ptr<tracy::View> load( std::memory_order = std::memory_order_seq_cst ) const
+    {
+        std::lock_guard lock( m_lock );
+        return m_ptr;
+    }
+    void store( std::shared_ptr<tracy::View> ptr, std::memory_order = std::memory_order_seq_cst )
+    {
+        std::lock_guard lock( m_lock );
+        m_ptr.swap( ptr );
+    }
+
+private:
+    mutable std::mutex m_lock;
+    std::shared_ptr<tracy::View> m_ptr;
+};
+static AtomicViewPtr view;
