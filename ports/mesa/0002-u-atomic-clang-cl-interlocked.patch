+__forceinline long _interlockedadd(long volatile * _Addend, long _Value)
+{
+   return _InterlockedExchangeAdd(_Addend, _Value) + _Value;
+}
+
+__forceinline __int64 _interlockedadd64(__int64 volatile * _Addend, __int64 _Value)
