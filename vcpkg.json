{
  "name": "speedo",
  "version": "0.0.1",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "vcpkg-cmake-get-vars",
      "host": true
    },
    {
      "name": "vcpkg-tool-fastbuild",
      "host": true
    },
    {
      "name": "llvm",
      "default-features": false,
      "features": [
        "clang",
        "clang-tools-extra",
        "default-targets",
        "libcxx",
        "lld"
      ],
      "host": true
    },
    {
      "name": "llvm",
      "default-features": false,
      "features": [ "compiler-rt", "libcxxabi" ],
      "platform": "!windows",
      "host": true
    },
    {
      "name": "mesa",
      "platform": "osx & arm64",
      "host": true
    },
    {
      "name": "mesa",
      "default-features": false,
      "features": [ "lavapipe" ],
      "platform": "(windows | linux) & x64",
      "host": true
    }
  ],
  "features": {
    "common": {
      "description": "Common Dependencies for both Client and Server",
      "dependencies": [
        "cargs",
        "concurrentqueue",
        "cppzmq",
        "cpptrace",
        "libdeflate",
        {
          "name": "mimalloc",
          "features": [
            "override",
            "secure"
          ]
        },
        "mio",
        "picosha2",
        "sha-intrinsics",
        "stduuid",
        "tl-function-ref",
        "tracy",
        "unordered-dense",
        "xxhash",
        {
          "name": "zeromq",
          "features": [ "draft" ]
        },
        "zpp-bits"
      ]
    },
    "client": {
      "description": "Game Client Executable",
      "dependencies": [
        {
          "name": "speedo",
          "default-features": false,
          "features": [ "common" ]
        },
        "bcdec",
        "cgltf",
        "curl",
        "draco",
        "glfw3",
        {
          "name": "glfw3",
          "default-features": false,
          "features": [ "wayland" ],
          "platform": "linux"
        },
        "glm",
        {
          "name": "imgui",
          "features": [
            "freetype",
            "glfw-binding",
            "wchar32"
          ]
        },
        {
          "name": "ktx",
          "default-features": false
        },
        {
          "name": "libwebp",
          "default-features": false,
          "features": [
            "simd",
            "unicode"
          ]
        },
        "mikktspace",
        {
          "name": "meshoptimizer",
          "default-features": false
        },
        "parallel-hashmap",
        "shader-slang",
        "stb",
        "tinybvh",
        "tinyobjloader",
        "vulkan",
        "vulkan-crash-diagnostic-layer",
        "vulkan-headers",
        "vulkan-loader",
        "vulkan-memory-allocator",
        "vulkan-utility-libraries",
        "vulkan-validationlayers"
      ]
    },
    "server": {
      "description": "Game Server Executable",
      "dependencies": [
        {
          "name": "speedo",
          "default-features": false,
          "features": [ "common" ]
        }
      ]
    },
    "profiler-app": {
      "description": "Tracy's profiler app (tracy-profiler), for local development: setup.ps1 leaves it out with SPEEDO_PROFILER_APP=0, as CI does",
      "dependencies": [
        {
          "name": "tracy",
          "features": [ "gui-tools" ]
        }
      ]
    }
  },
  "default-features": [
    "client",
    "server",
    "profiler-app"
  ]
}
